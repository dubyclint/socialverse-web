# .nuxtignore - PREVENT SERVER CODE FROM PRERENDER BUNDLING
# ============================================================================
# Patterns use .gitignore syntax and are matched against paths relative to the
# project root. Keep every pattern anchored with a leading `/`: an unanchored
# pattern such as `dist` matches *any* nested directory of that name, including
# `node_modules/<pkg>/dist`, which silently strips module auto-imports
# (e.g. `useSupabaseUser` from `@nuxtjs/supabase/dist/runtime/composables`).
# ============================================================================

# Build Cache Directories
/node_modules/.cache
/.nuxt
/.output
/.nitro
/.vite
/.turbo
/dist

# Development & IDE
/.vscode
/.idea
/.git
/.github

# Testing & Coverage
/coverage
/.nyc_output
/tests
/__tests__
/*.lcov
/**/*.test.ts
/**/*.spec.ts

# Documentation
/docs
/*.md

# Logs
/logs
/*.log

# CI/CD
/.gitlab-ci.yml
/.circleci
/.travis.yml
/azure-pipelines.yml
